{
  "id": "observe-views",
  "kind": "cli",
  "layer": "ext",
  "entry": "observe.mjs",
  "domain": "observe",
  "desc": "cong doc audit/du lieu: view|why|map|query|digest|prune|runs|sizes|data-prune|cost|evidence (chi doc, prune mac dinh dry-run)",
  "cmds": "view [YYYY-MM-DD] | why | map | query --report R | digest D | prune | runs list|show | sizes | data-prune | cost | evidence",
  "default": "index",
  "domains": {
    "observe": { "file": "observe.mjs", "desc": "cong doc audit/du lieu (gop audit, audit-query, runs)", "cmds": "view [YYYY-MM-DD] | why | map | query --report R | digest D | prune | runs list|show | sizes | data-prune | cost | evidence", "default": "index", "aliases": ["audit", "audit-query", "runs", "cost", "evidence"] }
  },
  "aliasMap": {
    "audit": { "pass": ["view", "query", "digest", "prune", "why", "map"], "fallback": ["view"] },
    "audit-query": { "fallback": ["query"] },
    "runs": { "fallback": ["runs"] },
    "cost": { "fallback": ["cost"], "onEmpty": ["cost"] },
    "evidence": { "fallback": ["evidence"], "onEmpty": ["evidence"] }
  },
  "files": {
    "helpers": ["runs.mjs", "data.mjs", "sizes.mjs", "digest.mjs", "prune.mjs"],
    "review": ["review/review.mjs", "review/util.mjs", "review/view.mjs", "review/view-format.mjs", "review/why-map.mjs"],
    "query": ["query/query.mjs", "query/files.mjs", "query/rows.mjs", "query/engine.mjs", "query/duck.mjs", "query/format.mjs", "query/args.mjs"]
  },
  "tests": ["data.test.mjs", "digest.test.mjs", "review/review.test.mjs", "review/why.test.mjs", "query/query.test.mjs"],
  "config": { "defaults": null, "schema": null },
  "data": "audit",
  "tier": "T1"
}
