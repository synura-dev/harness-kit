{
  "_doc": "Muc data dung chung (khong chua du lieu du an). Khoa = ten thu muc vat ly cap 1 (hoac `path`). zone: system|knowledge|workspaces|external. class: log|cache|artifact|durable (mac dinh retention/caps theo class, xem core/registry/data-registry.mjs). retentionDays ghi de class. target = dich cuoi neu khac vi tri hien tai. Muc theo workspace o config/data/workspaces/<ws>.json.",
  "enforce": "warn",
  "entries": {
    "audit": {
      "zone": "system",
      "class": "log",
      "owner": "harness/observe/audit",
      "retentionDays": 90,
      "note": "events 30d do audit prune; digest 90d; gateway/ = log cong (logGateway)",
      "tailPaths": {
        "gateway": "gateway"
      },
      "target": "system/audit",
      "path": "system/audit"
    },
    "play": {
      "zone": "system",
      "class": "log",
      "owner": "harness/tools/play",
      "retentionDays": 14,
      "target": "system/play",
      "path": "system/play"
    },
    "worktree": {
      "zone": "system",
      "class": "log",
      "owner": "harness/constrain/worktree",
      "retentionDays": 30,
      "target": "system/worktree",
      "path": "system/worktree"
    },
    "watchdog": {
      "zone": "system",
      "class": "log",
      "owner": "harness/cli/commands/proc-watch.mjs",
      "retentionDays": 14,
      "target": "system/watchdog",
      "path": "system/watchdog"
    },
    "ledger": {
      "zone": "system",
      "class": "durable",
      "owner": "harness/observe/ledger",
      "note": "so su co ledger.jsonl + state.json (job lo)",
      "target": "system/ledger",
      "path": "system/ledger"
    },
    "proc": {
      "zone": "system",
      "class": "cache",
      "owner": "harness/core/runtime/proc.mjs",
      "retentionDays": 7,
      "note": "so PID tac vu nen (proc-ledger.json), thay os.tmpdir()",
      "target": "system/proc",
      "path": "system/proc"
    },
    "proc-orphans": {
      "zone": "system",
      "class": "log",
      "owner": "harness/constrain/proc-orphans",
      "retentionDays": 7,
      "target": "system/proc-orphans",
      "path": "system/proc-orphans"
    },
    "ext-inject": {
      "zone": "system",
      "class": "log",
      "owner": "harness/build/ext-inject",
      "retentionDays": 1,
      "target": "system/ext-inject",
      "path": "system/ext-inject"
    },
    "evolve": {
      "zone": "knowledge",
      "class": "durable",
      "owner": "harness/evolve/loop",
      "target": "knowledge/evolve"
    },
    "eval": {
      "zone": "knowledge",
      "class": "artifact",
      "owner": "harness/evolve/eval",
      "target": "knowledge/eval"
    }
  },
  "_externalRule": "Du lieu do ben ngoai harness sinh: data scan phat hien -> data adopt vao _inbox -> duyet: dang ky (zone external neu la app-state) hoac xoa; doctor canh bao.",
  "reserved": [
    "README.md",
    "_inbox",
    ".state"
  ]
}
