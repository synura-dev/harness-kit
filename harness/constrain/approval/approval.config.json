{
  "mode": "enforce",
  "maxInputBytes": 1048576,
  "maxCommandChars": 100000,
  "hardTimeoutMs": 2500,
  "logAllow": false,
  "reuseRules": [
    { "file": "harness/constrain/guard/hook.config.json", "ids": ["git-force-push"], "tier": "deny" }
  ],
  "delete": {
    "threshold": 10,
    "unknownCount": "ask",
    "maxDirEntries": 5000,
    "maxDepth": 3,
    "posix": ["rm", "unlink"],
    "ps": ["remove-item", "ri", "rm", "del", "erase", "rd", "rmdir"],
    "cmd": ["del", "erase", "rd", "rmdir"],
    "dirOnly": ["rmdir", "rd"],
    "alwaysRecursive": ["rimraf", "del-cli", "trash", "rmtree"],
    "wrappers": ["sudo", "env", "command", "nohup", "time", "timeout", "exec", "npx", "bunx", "pnpx", "doas", "nice", "ionice", "setsid", "stdbuf", "busybox", "builtin"],
    "shells": ["sh", "bash", "zsh", "dash", "ksh", "pwsh", "powershell", "cmd", "wsl"]
  },
  "askRules": [
    {
      "id": "git-reset-hard",
      "regex": "\\bgit(?:\\.exe)?[\"']?\\s+(?:[^;&|\\n\\s]+\\s+){0,12}?[\"']?reset(?![\\w-])(?:\\s+[^;&|\\n\\s]+){0,12}?\\s+[\"']?--hard(?![\\w-])",
      "reason": "git reset --hard xoa thay doi chua commit, can nguoi duyet. / git reset --hard discards uncommitted work, needs human approval."
    },
    {
      "id": "git-push",
      "regex": "\\bgit(?:\\.exe)?[\"']?\\s+(?:[^;&|\\n\\s]+\\s+){0,12}?[\"']?push(?![\\w-])",
      "unless": "\\bpush(?:\\s+[^;&|\\n\\s]+){0,40}?\\s+(?:--dry-run|-n)(?![\\w-])",
      "reason": "git push can nguoi duyet. / git push needs human approval."
    },
    {
      "id": "deploy-script",
      "regex": "\\b(?:npm|pnpm|yarn|bun)(?:\\.cmd|\\.exe)?(?:\\s+run(?:-script)?)?\\s+[\"']?deploy[\\w:.-]{0,60}[\"']?(?=[\\s;&|)\"']|$)",
      "reason": "Lenh deploy can nguoi duyet. / Deploy needs human approval."
    },
    {
      "id": "deploy-cli",
      "regex": "\\b(?:vercel|netlify|firebase|fly|flyctl|wrangler|serverless|sls|railway|heroku|pm2|cap|eb|amplify|gcloud|aws|az|kamal|dokku)(?:\\.exe|\\.cmd)?\\b(?:\\s+[^;&|\\n\\s]+){0,8}?\\s+[\"']?(?:deploy|publish)\\b|\\bvercel\\b(?:\\s+[^;&|\\n\\s]+){0,8}?\\s+--prod\\b|\\bkubectl\\s+(?:[^;&|\\n\\s]+\\s+){0,6}?(?:apply|rollout|replace|patch|scale|set\\s+image)\\b|\\bhelm\\s+(?:[^;&|\\n\\s]+\\s+){0,4}?(?:upgrade|install|rollback|uninstall)\\b|\\bterraform\\s+(?:[^;&|\\n\\s]+\\s+){0,4}?(?:apply|destroy)\\b|\\bdocker(?:\\s+[^;&|\\n\\s]+){0,4}?\\s+(?:push|stack\\s+deploy)\\b",
      "reason": "Lenh deploy can nguoi duyet. / Deploy needs human approval."
    },
    {
      "id": "deploy-file",
      "regex": "(?:^|[;&|(\\n]|\\b(?:bash|sh|zsh|pwsh|powershell|node|bun|python3?|tsx|deno|source)(?:\\.exe)?(?:\\s+-[^\\s;&|]*){0,4})\\s{0,8}[\"'&]?\\s{0,8}(?:[^\\s;&|\"']{0,200}[\\\\/])?[\\w.-]{0,80}deploy[\\w.-]{0,80}\\.(?:sh|ps1|bat|cmd|mjs|cjs|js|ts|py)\\b",
      "reason": "Chay script deploy can nguoi duyet. / Deploy script needs human approval."
    },
    {
      "id": "migrate",
      "regex": "\\bprisma\\s+(?:migrate\\s+(?:deploy|dev|reset|resolve)|db\\s+(?:push|execute|seed))\\b|\\bknex(?:\\s+[^;&|\\n\\s]+){0,4}?\\s+migrate:(?:latest|up|down|rollback)\\b|\\bsequelize(?:-cli)?\\s+db:migrate|\\btypeorm[\\w-]{0,30}\\s+(?:[^;&|\\n\\s]+\\s+){0,4}?migration:(?:run|revert)\\b|\\b(?:npm|pnpm|yarn|bun)(?:\\s+run)?\\s+[\"']?(?:db:)?migrat[\\w:.-]{0,40}|\\bmanage\\.py\\s+migrate\\b|\\b(?:rails|rake)\\s+db:(?:migrate|rollback|reset|schema:load)\\b|\\bflyway\\b(?:\\s+[^;&|\\n\\s]+){0,6}?\\s+(?:migrate|clean|repair)\\b|\\bliquibase\\b(?:\\s+[^;&|\\n\\s]+){0,6}?\\s+(?:update|rollback)\\b|\\bdrizzle-kit\\s+(?:push|migrate)\\b|\\balembic\\s+(?:upgrade|downgrade)\\b|\\bartisan\\s+migrate\\b|\\bdbmate\\s+(?:up|migrate|rollback)\\b|\\bgoose\\b(?:\\s+[^;&|\\n\\s]+){0,6}?\\s+(?:up|down|reset)\\b|\\bmigrate\\s+-(?:path|database|source)\\b|\\b(?:node|bun|tsx|deno)\\s+(?:-[^\\s;&|]*\\s+){0,4}[^\\s;&|]{0,200}migrat[\\w.-]{0,60}\\.(?:m?js|cjs|ts)\\b",
      "reason": "Lenh migrate DB can nguoi duyet. / DB migration needs human approval."
    },
    {
      "id": "ssh-restart",
      "regex": "\\bssh(?:\\.exe)?\\b[^\\n]{0,4000}?\\b(?:reload|restart)\\b",
      "reason": "ssh chay reload/restart tren may chu can nguoi duyet. / Remote reload/restart needs human approval."
    },
    {
      "id": "release-apply",
      "regex": "harness\\.mjs[\"']?\\s+(?:(?!\\S*harness\\.mjs)[^\\s;&|]+\\s+)*?[\"']?release[\"']?(?![\\w.-])(?!\\s+(?:(?:--(?:project|env|timeout-s|max-bytes|confirm|backup|run|expect-hash|mark|restarts)\\s+[^\\s;&|-][^\\s;&|]*|-(?!-(?:project|env|timeout-s|max-bytes|confirm|backup|run|expect-hash|mark|restarts)(?:\\s|$))[^\\s;&|]*)\\s+)*[\"']?(?:plan|preflight|status|verify)[\"']?(?![\\w.-]))|\\b(?:node|bun|tsx|deno)(?:\\.exe)?[\"']?\\s+(?:(?!(?:node|bun|tsx|deno)(?:\\.exe)?[\"'\\s])[^\\s;&|]+\\s+)*?[\"']?(?:[^\\s;&|\"']*[\\\\/])?release[\\\\/]cli\\.mjs[\"']?(?![\\w.-])(?!\\s+(?:(?:--(?:project|env|timeout-s|max-bytes|confirm|backup|run|expect-hash|mark|restarts)\\s+[^\\s;&|-][^\\s;&|]*|-(?!-(?:project|env|timeout-s|max-bytes|confirm|backup|run|expect-hash|mark|restarts)(?:\\s|$))[^\\s;&|]*)\\s+)*[\"']?(?:plan|preflight|status|verify)[\"']?(?![\\w.-]))|(?:\\bimport\\s*\\(|\\brequire\\s*\\(|\\bfrom\\s+)\\s*[\"'`][^\"'`\\n]{0,300}?(?:release[\\\\/](?:cli|steps|scripts|remote)|\\.{1,2}[\\\\/](?:cli|steps|scripts))\\.mjs|\\b(?:cd|pushd|chdir|set-location|sl)\\s+[\"']?[^\\s;&|\"']*release[\\\\/]*[\"']?[^\\n]{0,200}?(?:node|bun|tsx|deno)(?:\\.exe)?[\"']?\\s+(?:[^\\s;&|]+\\s+)*?[\"']?(?:\\.[\\\\/])?cli\\.mjs[\"']?(?![\\w.-])(?!\\s+(?:(?:--(?:project|env|timeout-s|max-bytes|confirm|backup|run|expect-hash|mark|restarts)\\s+[^\\s;&|-][^\\s;&|]*|-(?!-(?:project|env|timeout-s|max-bytes|confirm|backup|run|expect-hash|mark|restarts)(?:\\s|$))[^\\s;&|]*)\\s+)*[\"']?(?:plan|preflight|status|verify)[\"']?(?![\\w.-]))",
      "reason": "release apply/rollback trien khai len may chu, can nguoi duyet. / Release apply/rollback deploys to a server, needs human approval."
    },
    {
      "id": "evolve-apply",
      "regex": "harness\\.mjs[\"']?(?:\\s+[^;&|\\n\\s]+){0,6}?\\s+[\"']?evolve[\"']?(?:\\s+[^;&|\\n\\s]+){0,4}?\\s+[\"']?(?:apply|rollback)(?![\\w.-])|(?:evolve[\\\\/]loop\\b[^\\n]{0,400}?\\b|(?:^|[\\\\/\\s\"'])loop[\\\\/])cli\\.mjs[\"']?(?:\\s+[^;&|\\n\\s]+){0,4}?\\s+[\"']?(?:apply|rollback)(?![\\w.-])|(?:evolve[\\\\/]+loop|loop(?:\\.mjs|[\\\\/]cli\\.mjs))[^\\n]{0,400}?\\b(?:apply|rollback)(?![\\w-])",
      "reason": "evolve apply/rollback sua config/luat that cua harness, can nguoi duyet. / Applying or rolling back a harness evolution needs human approval."
    },
    {
      "id": "evolve-eval-cmd",
      "regex": "HARNESS_EVOLVE_EVAL_CMD|(?:\\bevolve\\b|loop(?:\\.mjs|[\\\\/]cli\\.mjs))[^\\n]{0,400}?--eval-cmd(?![\\w-])",
      "reason": "evolve voi oracle tu chon (--eval-cmd / HARNESS_EVOLVE_EVAL_CMD) co the chay lenh tuy y, can nguoi duyet. / Custom evolve oracle command needs human approval."
    },
    {
      "id": "eval-baseline-force",
      "regex": "(?:harness\\.mjs[\"']?(?:\\s+[^;&|\\n\\s]+){0,6}?\\s+[\"']?eval[\"']?|(?:evolve[\\\\/]eval\\b[^\\n]{0,400}?\\b|(?:^|[\\\\/\\s\"'])eval[\\\\/])cli\\.mjs[\"']?|(?:evolve[\\\\/]+loop\\b[^\\n]{0,400}?\\b|(?:^|[\\\\/\\s\"'])loop[\\\\/])cli\\.mjs[\"']?(?:\\s+[^;&|\\n\\s]+){0,4}?\\s+[\"']?eval[\"']?)(?=(?:\\s+[^;&|\\n\\s]+){0,12}?\\s+[\"']?baseline(?![\\w.-]))(?=(?:\\s+[^;&|\\n\\s]+){0,12}?\\s+[\"']?--force(?![\\w.-]))",
      "reason": "eval baseline --force ghi de chuan khi co ca truot (ha chuan), can nguoi duyet. / Forcing an eval baseline with failures needs human approval."
    }
  ]
}
