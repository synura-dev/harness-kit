{
  "mode": "enforce",
  "logFile": "",
  "maxInputBytes": 1048576,
  "maxCommandChars": 100000,
  "remoteHostAliases": [],
  "allowlist": [
    {
      "id": "hub-local-node",
      "regex": "^\\s*node\\s+(--test\\b|\"?harness[\\\\/])",
      "for": [
        "remote-node-run"
      ]
    }
  ],
  "denyPatterns": [
    {
      "id": "mongo-cli",
      "regex": "\\b(mongosh|mongodump|mongoexport|mongoimport|mongorestore|mongostat)\\b|\\bmongo\\s",
      "reason": "Cam mongo shell/tools. Khong doc/thao tac DB. / Mongo CLI blocked; use app-level tools or ask the human."
    },
    {
      "id": "mongo-uri",
      "regex": "mongodb(\\+srv)?://",
      "reason": "Cam chuoi ket noi MongoDB. / MongoDB connection string blocked."
    },
    {
      "id": "mongo-driver",
      "regex": "mongoose\\s*\\.\\s*(connect|createConnection)|\\bMongoClient\\b",
      "reason": "Cam ket noi DB bang driver. / DB driver connect blocked."
    },
    {
      "id": "db-cli-remote",
      "remote": true,
      "regex": "\\b(psql|mysql|redis-cli)\\b",
      "reason": "Cam db client tren host tu xa. / DB client over ssh blocked."
    },
    {
      "id": "git-force-push",
      "regex": "\\bgit(?:\\.exe)?[\"']?\\s+(?:(?![\"']?push\\b)[^;&|\\n\\s]+\\s+){0,12}[\"']?push\\b(?:\\s+[^;&|\\n\\s]+){0,40}?\\s+(?:[\\\\\"']*(?:-[a-z]*[fd][a-z]*(?=[\\s\"'\\x60);&|>]|$)|--(?:force(?!-if-includes)|mirr\\w*|del\\w*|prune))|(?:[\"'\\\\]*[+:]\\S|[^;&|\\n\\s]*:\\+))|\\bgit(?:\\.exe)?[\"']?\\s+(?:[^;&|\\n\\s]+\\s+){0,12}?-c\\s+[\"']?alias\\.[^\\s=]*=[\"']?push\\b(?:\\s+[^;&|\\n\\s]+){0,40}?\\s+(?:[\\\\\"']*(?:-[a-z]*[fd][a-z]*(?=[\\s\"'\\x60);&|>]|$)|--(?:force(?!-if-includes)|mirr\\w*|del\\w*|prune))|(?:[\"'\\\\]*[+:]\\S|[^;&|\\n\\s]*:\\+))|\\bgit(?:\\.exe)?[\"']?\\s+(?:[^;&|\\n\\s]+\\s+){0,12}?-c\\s+[\"']?remote\\.[^\\s=]*\\.push=[\"']?\\+|\\bgit(?:\\.exe)?\\s+send-pack\\b(?:\\s+[^;&|\\n\\s]+){0,40}?\\s+--force",
      "reason": "Cam git push --force/-f/--force-with-lease/--mirror/--delete/+refspec/:nhanh (ghi de/xoa lich su tu xa). Hoi human, khong tu push. / Destructive git push blocked; ask the human."
    },
    {
      "id": "remote-cat",
      "remote": true,
      "regex": "\\bcat\\s+(?!>)",
      "unless": "\\|\\s*(head|tail|wc|sha256sum|md5sum|grep)\\b",
      "reason": "Cam cat khong gioi han qua ssh. Dung head/tail/wc/grep -n. / Unbounded remote cat blocked."
    },
    {
      "id": "remote-node-run",
      "remote": true,
      "regex": "\\b(node|bun)\\s+(?!-)[\\w./~$\\\\-]+\\.(m?js|cjs|ts)\\b",
      "reason": "Cam chay file node/bun tren host tu xa. Chi cho node --check, node -v, node -e khong co tu khoa DB. / Remote script run blocked; allowed: node --check, -v, safe -e."
    }
  ]
}
