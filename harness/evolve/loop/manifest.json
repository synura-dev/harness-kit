{
  "id": "evolve-loop",
  "kind": "cli",
  "layer": "ext",
  "entry": "cli.mjs",
  "domain": "evolve",
  "desc": "vong tien hoa: loi lap (>=3 lan/7 ngay) -> de xuat -> oracle eval -> apply --approve co version -> rollback",
  "cmds": ["prune-candidates", "patterns", "candidates", "propose", "check", "apply", "rollback", "log", "list", "autopilot [--dry-run]", "queue [--approve <id>|--reject <id>]", "eval run|list|baseline|compare|bench"],
  "default": "index",
  "aliases": ["eval"],
  "aliasMap": { "eval": { "fallback": ["eval"], "onEmpty": ["eval", "help"] } },
  "files": { "helpers": ["loop.mjs", "policy.mjs", "patterns.mjs", "prune.mjs", "prune-cli.mjs", "autopilot.mjs", "rule-content.mjs"] },
  "tests": ["loop.test.mjs", "patterns.test.mjs", "prune.test.mjs", "autopilot.test.mjs", "rule-content.test.mjs"],
  "config": { "defaults": null, "schema": null },
  "data": "evolve",
  "tier": "T1"
}
