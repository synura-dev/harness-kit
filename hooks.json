{
  "harness-kit": {
    "SessionStart": [
      { "type": "command", "command": "node ./harness/hooks/dispatch/agy-native.mjs SessionStart", "timeout": 10 }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [{ "type": "command", "command": "node ./harness/hooks/dispatch/agy-native.mjs PreToolUse", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|read_file|view_file|call_mcp_tool|send_message|invoke_subagent|mcp_.*",
        "hooks": [{ "type": "command", "command": "node ./harness/hooks/dispatch/agy-native.mjs PostToolUse", "timeout": 5 }]
      }
    ],
    "PostInvocation": [
      { "type": "command", "command": "node ./harness/hooks/dispatch/agy-native.mjs PostInvocation", "timeout": 5 }
    ],
    "Stop": [
      { "type": "command", "command": "node ./harness/hooks/dispatch/agy-native.mjs Stop", "timeout": 5 }
    ]
  }
}
